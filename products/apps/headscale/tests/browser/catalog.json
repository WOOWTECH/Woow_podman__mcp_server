{
  "tools": [
    {
      "name": "headscale_users",
      "category": "Users",
      "description": "Manage users; rename updates the Headscale user name, including OIDC users. It does not change the identity provider account. Name synchronization at the next IdP login is not guaranteed.",
      "operations": [
        "list",
        "create",
        "rename",
        "delete"
      ],
      "enabled": true,
      "denied_operations": [],
      "input_schema": {
        "type": "object",
        "$defs": {
          "headscale_users_create": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "create",
                "title": "Operation",
                "type": "string"
              },
              "name": {
                "maxLength": 2048,
                "minLength": 1,
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                },
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f/\\\\%?#]+$",
                "title": "Name",
                "type": "string"
              },
              "display_name": {
                "default": "",
                "maxLength": 2048,
                "title": "Display Name",
                "type": "string"
              },
              "email": {
                "default": "",
                "maxLength": 2048,
                "title": "Email",
                "type": "string"
              },
              "picture_url": {
                "default": "",
                "maxLength": 2048,
                "title": "Picture Url",
                "type": "string"
              }
            },
            "required": [
              "operation",
              "name"
            ],
            "title": "headscale_users_create",
            "type": "object"
          },
          "headscale_users_delete": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "delete",
                "title": "Operation",
                "type": "string"
              },
              "user_id": {
                "title": "User Id",
                "type": "string"
              }
            },
            "required": [
              "operation",
              "user_id"
            ],
            "title": "headscale_users_delete",
            "type": "object"
          },
          "headscale_users_list": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "list",
                "title": "Operation",
                "type": "string"
              },
              "user_id": {
                "default": null,
                "title": "User Id",
                "type": "string"
              },
              "name": {
                "default": null,
                "maxLength": 2048,
                "minLength": 1,
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                },
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f/\\\\%?#]+$",
                "title": "Name",
                "type": "string"
              },
              "email": {
                "default": null,
                "maxLength": 2048,
                "title": "Email",
                "type": "string"
              }
            },
            "required": [
              "operation"
            ],
            "title": "headscale_users_list",
            "type": "object"
          },
          "headscale_users_rename": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "rename",
                "title": "Operation",
                "type": "string"
              },
              "user_id": {
                "title": "User Id",
                "type": "string"
              },
              "new_name": {
                "maxLength": 2048,
                "minLength": 1,
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                },
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f/\\\\%?#]+$",
                "title": "New Name",
                "type": "string"
              }
            },
            "required": [
              "operation",
              "user_id",
              "new_name"
            ],
            "title": "headscale_users_rename",
            "type": "object"
          }
        },
        "discriminator": {
          "mapping": {
            "create": "#/$defs/headscale_users_create",
            "delete": "#/$defs/headscale_users_delete",
            "list": "#/$defs/headscale_users_list",
            "rename": "#/$defs/headscale_users_rename"
          },
          "propertyName": "operation"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/headscale_users_list"
          },
          {
            "$ref": "#/$defs/headscale_users_create"
          },
          {
            "$ref": "#/$defs/headscale_users_rename"
          },
          {
            "$ref": "#/$defs/headscale_users_delete"
          }
        ]
      }
    },
    {

                "type": "string"
              },
              "policy": {
                "maxLength": 262144,
                "minLength": 1,
                "title": "Policy",
                "type": "string"
              },
              "expected_digest": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Expected Digest",
                "type": "string"
              }
            },
            "required": [
              "operation",
              "policy",
              "expected_digest"
            ],
            "title": "headscale_policy_apply",
            "type": "object"
          },
          "headscale_policy_check": {
            "additionalProperties": false,

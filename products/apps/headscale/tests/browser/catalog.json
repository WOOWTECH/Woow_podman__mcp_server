            "expire": "#/$defs/headscale_nodes_expire",
            "get": "#/$defs/headscale_nodes_get",
            "list": "#/$defs/headscale_nodes_list",
            "rename": "#/$defs/headscale_nodes_rename",
            "set_tags": "#/$defs/headscale_nodes_set_tags"

            ],
            "title": "headscale_policy_check",
            "type": "object"
          },
          "headscale_policy_diff": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "diff",
                "title": "Operation",
                "type": "string"
              },
              "policy": {
                "maxLength": 262144,
                "minLength": 1,
                "title": "Policy",
                "type": "string"
              }
            },
            "required": [
              "operation",
              "policy"
            ],
            "title": "headscale_policy_diff",
            "type": "object"
          },
          "headscale_policy_get": {
            "additionalProperties": false,
            "properties": {
              "operation": {

    {
      "name": "headscale_policy",
      "category": "Access policy",
      "description": "Read, validate, diff or apply a whole policy. Get returns exists=false with an absence digest when database policy is not set; use that digest for first apply. Apply validates and compares the digest before writing, then independently reads back. Failed verification or a differing readback is an error; upstream has no atomic CAS and other writers can still race.",
      "operations": [
        "get",
        "check",
        "diff",
        "apply"
      ],
      "enabled": true,
      "denied_operations": [],
      "input_schema": {
        "type": "object",

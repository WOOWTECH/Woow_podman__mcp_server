# Per-host public settings; copied as 0600 on first install. No secrets here.
# Default GUI: http://127.0.0.1:18081/ (local use only).
MCP_ADMIN_BIND=127.0.0.1
MCP_ADMIN_PORT=18081
HEADSCALE_MCP_ALLOWED_ORIGINS=http://127.0.0.1:18081
HEADSCALE_MCP_SECURE_COOKIE=false
# Add only the actual private Headscale API destination, preferably /32 or /128.
HEADSCALE_MCP_ALLOWED_PRIVATE_CIDRS=
# Container memory ceiling; extra profiles are refused when it cannot hold another child.
MCP_MEMORY_LIMIT=1g

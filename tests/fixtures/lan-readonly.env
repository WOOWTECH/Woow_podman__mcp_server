# tests/dryrun.sh variant: a host whose tunnel runs on another machine (LAN bind), with the
# readonly profile and a name allow-list, i.e. the toypark1234 test settings on a LAN IP.
MCP_ADMIN_BIND=192.168.2.197
MCP_ADMIN_PORT=28880
PODMAN_MCP_PROFILE=readonly
PODMAN_MCP_NAME_ALLOW=^podman-mcp-admin$
PODMAN_API_VERSION=v4.9.3
PODMAN_MCP_MAX_CHARS=20000
JWT_EXPIRY_HOURS=12

# Per-host settings for podman-mcp-admin. scripts/install.sh copies this file to
# ~/.config/podman-mcp-admin/podman-mcp-admin.env (mode 0600) on the first install and
# renders the values into the Quadlet units. Edit that copy, then re-run install.sh: a
# changed value restarts the container, an unchanged re-run restarts nothing.
#
# Plain KEY=VALUE lines: no quotes, no `export`, no trailing comments, no spaces.
# Secrets are NOT here: install.sh generates them as podman secrets.

# Publish address and port. Loopback only by default: put a tunnel or proxy on the same
# host in front of it. Use a LAN IP only when that tunnel runs on another machine (README
# "Behind a Cloudflare tunnel"). 0.0.0.0 is refused.
MCP_ADMIN_BIND=127.0.0.1
MCP_ADMIN_PORT=8080

# readonly (13 tools) | safe (18, adds exec/start/stop/pull) | full (23).
# Even readonly includes container inspect, which returns the environment of every
# container of this user, including podman secrets passed as env.
PODMAN_MCP_PROFILE=safe

# Optional regex limiting which container/pod names the tools may touch (empty = all).
PODMAN_MCP_NAME_ALLOW=

# libpod API version prefix. install.sh writes the daemon's own version on the first
# install; a newer value than the daemon supports makes every call 404.
PODMAN_API_VERSION=v4.9.3

PODMAN_MCP_MAX_CHARS=20000
JWT_EXPIRY_HOURS=12

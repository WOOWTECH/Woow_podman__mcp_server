# ---------------------------------------------------------------------------
# Woow Podman MCP server — example environment
# Copy to `.env` and fill in. NEVER commit a real JWT secret or admin password.
# ---------------------------------------------------------------------------

# === Component 1: the FastMCP server =======================================

# How to reach the Podman host.
#   local, rootless : unix:///run/podman/podman.sock   (mount it into the container)
#   remote over TCP : tcp://podman-host:2376
# Enable the rootless socket first:  systemctl --user enable --now podman.socket
PODMAN_URI=unix:///run/podman/podman.sock

# libpod API version prefix. A version NEWER than the daemon answers 404 on
# every call, which reads as "endpoint missing" rather than "version wrong".
PODMAN_API_VERSION=v5.0.0

# Mutual TLS for a tcp:// host. FILE PATHS inside the container, not secrets.
# PODMAN_TLS_CA=/certs/ca.pem
# PODMAN_TLS_CERT=/certs/cert.pem
# PODMAN_TLS_KEY=/certs/key.pem

# --- gating -----------------------------------------------------------------
# Safety profile. Tools are gated at REGISTRATION time, not at list time, so a
# tool outside the profile is not merely hidden — it does not exist to call.
#   readonly : 13 tools — inspection only, nothing mutates
#   safe     : 18 tools — adds start/stop/restart/exec/pull  (default)
#   full     : 23 tools — adds remove/prune/kill-class operations
PODMAN_MCP_PROFILE=safe

# Response size ceiling per tool call, in characters. Large hosts produce
# `podman system df` output far past any context window; the tools truncate by
# ROW and say how many rows they dropped rather than cutting mid-JSON.
PODMAN_MCP_MAX_CHARS=20000

# Comma/JSON list of individual tool names to disable on top of the profile,
# e.g. podman_container_exec
PODMAN_MCP_DISABLED_TOOLS=
PODMAN_MCP_DISABLED_CATEGORIES=
PODMAN_MCP_DISABLED_OPERATIONS=

# Hostnames the Streamable-HTTP transport will accept in the Host header.
# FastMCP's DNS-rebinding protection answers 421 "Invalid Host header" for
# anything not listed, which behind a tunnel looks like a broken proxy.
# Only needed when the MCP child is exposed directly rather than through the
# admin console's proxy.
# PODMAN_MCP_ALLOWED_HOSTS=podman-mcp.example.com

# === Component 2/3: the admin console (mcp_admin_core) ======================

# Where the file-backed config store lives (plaintext, chmod 600).
MCP_ADMIN_CONFIG=/data/config.json

# JWT signing secret for the admin GUI. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random per-process secret is used (sessions won't survive restarts).
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
JWT_EXPIRY_HOURS=12

# First-boot admin password. Omit and one is generated and logged exactly once.
# ADMIN_PASSWORD=

# Kubernetes namespace label surfaced on the dashboard (informational only).
NAMESPACE=podman-mcp
